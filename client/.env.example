# If you connected Redis via Vercel's "Upstash" Storage integration, it
# names these KV_REST_API_URL / KV_REST_API_TOKEN. A standalone Upstash
# account uses UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead.
# Either pair works — set whichever one your database actually gave you.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-rest-token
